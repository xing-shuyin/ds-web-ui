{
  "name": "ds-web-ui",
  "version": "0.1.12",
  "description": "Web chat interface for DeepSeek Harness (DSH) — UI faithfully ported from pi-web-ui, agent backend swapped to the DSH stdio JSON-RPC runtime. All JavaScript, no Python.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ds-web-ui": "server/index.js"
  },
  "main": "server/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "prepublishOnly": "npm run build:web",
    "prepack": "npm run build:web",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-spine-demo": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-fs-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-deepseek": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-pwsh-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-jsonrpc-demo": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-checkpoint-policy": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence-jsonl": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-pwsh": "^0.1.0-rc.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^4.21.2",
    "highlight.js": "^11.12.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "files": [
    "server/",
    "web/dist/",
    "vendor/runtime/cordis.yml",
    "vendor/runtime/dsh-jsonrpc-agent-launcher.js",
    "README.md",
    "LICENSE",
    "README.en.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xing-shuyin/ds-web-ui.git"
  },
  "homepage": "https://github.com/xing-shuyin/ds-web-ui",
  "bugs": {
    "url": "https://github.com/xing-shuyin/ds-web-ui/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "web-ui",
    "chat",
    "agent",
    "coding-agent",
    "pi-web-ui"
  ]
}
