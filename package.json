{
  "name": "ds-web-ui",
  "version": "0.1.0",
  "description": "Web chat interface for DeepSeek Harness (DSH) — UI faithfully ported from pi-web-ui, agent backend swapped to the DSH stdio JSON-RPC runtime. All JavaScript, no Python.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ds-web-ui": "server/index.js"
  },
  "main": "server/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-spine-demo": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-fs-local": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-deepseek": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-jsonrpc-demo": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-checkpoint-policy": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence-jsonl": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess-local": "^0.1.0-rc.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^4.21.2",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  }
}
